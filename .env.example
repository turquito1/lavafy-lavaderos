# ─── Base de datos ──────────────────────────────────────────────
# Local sin Docker: `npm run db:local` y usá esta URL.
# Producción: la URL de Neon (Vercel → Storage → Neon), con ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lavafy

# ─── Auth.js ────────────────────────────────────────────────────
# Generalo con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=cambiame
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
# URI de redirección autorizada: https://lavafy.com.ar/api/auth/callback/google  (y http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Solo en local: habilita "Entrar sin Google" para probar.
AUTH_DEV_LOGIN=true

# Emails con permiso de super admin (separados por coma)
SUPER_ADMIN_EMAILS=lopezmoraignacio@gmail.com

# ─── App ────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Si está, /landing muestra la landing del detailing (otro proyecto de Vercel con basePath "/landing").
LANDING_URL=

# ─── Emails (Resend) ────────────────────────────────────────────
# Sin clave, los mails se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM=Lavafy <turnos@lavafy.com.ar>

# ─── Cron (recordatorios) ───────────────────────────────────────
# Vercel lo manda solo como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=cambiame
